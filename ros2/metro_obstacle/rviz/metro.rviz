Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 30
      Color: 90; 90; 90
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Лидар (прорежено)
      Enabled: true
      Topic:
        Value: /obstacle/cloud_preview
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Точки в габарите
      Enabled: true
      Topic:
        Value: /obstacle/gauge_points
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Габарит и препятствие
      Enabled: true
      Topic:
        Value: /obstacle/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        gauge: true
        obstacle: true
        obstacle_text: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 28
    Fixed Frame: lidar_livox
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 0
        Y: -45
        Z: 0
      Distance: 75
      Pitch: 0.35
      Yaw: 1.5708
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: true
  X: 0
  Y: 0
